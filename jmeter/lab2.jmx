          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="simultaneous create with same name" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename">jmeter/lab2.groovy</stringProp>
          <stringProp name="parameters">unique</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="simultaneous update and delete" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="filename">jmeter/lab2.groovy</stringProp>
          <stringProp name="parameters">edit_delete</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="simultaneous valid and invalid import" enabled="true">
