<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="lab1" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <jta-data-source>java:jboss/datasources/lab1</jta-data-source>
        <class>core.model.AppUser</class>
        <class>core.model.Organization</class>
        <class>core.model.Coordinates</class>
        <class>core.model.Address</class>
        <class>core.model.Location</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jboss.as.jpa.providerModule" value="application"/>
            <property name="eclipselink.target-server" value="JBoss"/>
            <property name="eclipselink.ddl-generation" value="none"/>
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.cache.shared.default" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
