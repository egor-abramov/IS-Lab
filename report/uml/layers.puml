@startuml layers
!pragma layout smetana
skinparam dpi 180
skinparam defaultFontName Arial
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty fields
hide empty methods
set separator none
left to right direction

package core.handler {
    class OrganizationHandler {
        + list(page, size, filter..., sort...) : OrganizationPageDto
        + get(id) : OrganizationDto
        + create(OrganizationRequest) : Response
        + update(id, OrganizationRequest) : OrganizationDto
        + delete(id) : Response
    }
    class "Coordinates/Address/LocationHandler" as NestedHandler {
        + list() : ItemsDto
        + create(request) : Response
        + delete(id, replaceWith) : Response
    }
    class SpecialOpsHandler {
        + countFullNameGreater(value) : CountDto
        + nameContains(value) : ItemsDto
        + uniqueRatings() : RatingsDto
        + top5ByTurnover() : ItemsDto
        + avgEmployeesTop10() : AverageDto
    }
}

package core.handler.mapper {
    class "*ExceptionMapper" as Mappers {
        + toResponse(e) : Response
    }
}

package core.service {
    class OrganizationService {
        + list(...) : OrganizationPageDto
        + get(id) : OrganizationDto
        + create(OrganizationRequest) : OrganizationDto
        + update(id, OrganizationRequest) : OrganizationDto
        + delete(id) : void
    }
    class "Coordinates/Address/LocationService" as NestedService {
        + list() : ItemsDto
        + create(request) : Dto
        + delete(id, replacementId) : void
    }
    class SpecialOpsService
    class EntityValidator {
        + check(Object) : void
    }
}

package core.service.exception {
    abstract class AppException {
        + getErrors() : List<String>
    }
    class "NotFound/InvalidData/\nEntityInUseException" as Exceptions
}

package core.repository {
    abstract class BaseRepository {
        # inTransaction(work) : T
        # read(work) : T
    }
    class "Coordinates/Address/LocationRepository" as NestedRepository {
        + findAll() : List
        + findById(id)
        + save(entity)
        + countUsages(id) : long
        + deleteWithReplace(id, replacementId) : void
    }
    class OrganizationRepository {
        + findById(id) : Organization
        + save(Organization) : Organization
        + delete(id) : boolean
        + findPage(...) : List<Organization>
        + count(filterField, filterValue) : long
    }
    class SpecialOpsRepository {
        + countFullNameGreater(String) : long
        + findNameContains(String) : List<Organization>
        + uniqueRatings() : List<Long>
        + top5ByTurnover() : List<Organization>
        + avgEmployeesTop10() : double
    }
    class EmfProducer {
        + getEmf() : EntityManagerFactory
    }
}

package core.ws {
    class UpdateNotifier {
        + broadcast(String) : void
    }
    class UpdatesEndpoint
}

OrganizationHandler --> OrganizationService
NestedHandler --> NestedService
SpecialOpsHandler --> SpecialOpsService
Mappers ..> AppException
AppException <|-- Exceptions

OrganizationService --> OrganizationRepository
OrganizationService --> NestedRepository
OrganizationService --> EntityValidator
OrganizationService --> UpdateNotifier
NestedService --> NestedRepository
NestedService --> EntityValidator
NestedService --> UpdateNotifier
SpecialOpsService --> SpecialOpsRepository
OrganizationService ..> Exceptions
NestedService ..> Exceptions
UpdateNotifier ..> UpdatesEndpoint

BaseRepository <|-- OrganizationRepository
BaseRepository <|-- NestedRepository
BaseRepository <|-- SpecialOpsRepository
BaseRepository ..> EmfProducer : EntityManagerFactory
@enduml
